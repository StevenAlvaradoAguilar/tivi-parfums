datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      String      @default("PENDING")
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Float
  quantity  Int
  image     String?
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String   @default("TIVI")
  description String
  price       Float
  size        String   @default("100 ml")
  category    String   // ej: "Oriental", "Floral", "Woody"
  image       String   // URL pública almacenada en Supabase Storage
  stock       Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}